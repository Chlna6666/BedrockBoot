<entry:BedrockBootPage xmlns="https://github.com/avaloniaui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:breadcrumb="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation.Breadcrumb;assembly=OnePointUI.Avalonia"
                       xmlns:entry="clr-namespace:BedrockBoot.Base.Entry;assembly=BedrockBoot.Base"
                       xmlns:navigation="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation;assembly=OnePointUI.Avalonia"
                       xmlns:controls="clr-namespace:Material.Avalonia.Controls;assembly=Material.Avalonia"
                       xmlns:breadcrumb1="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation.Breadcrumb;assembly=Material.Avalonia"
                       mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                       x:Class="BedrockBoot.Views.Pages.MainSubPage.MainSettingPage">
    <entry:BedrockBootPage.HeaderView>
        <breadcrumb1:BreadcrumbBar HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Name="BreadcrumbBar" />
    </entry:BedrockBootPage.HeaderView>
    <Grid>
        <controls:NavigationFrame Name="SettingFrame" />
    </Grid>
</entry:BedrockBootPage>