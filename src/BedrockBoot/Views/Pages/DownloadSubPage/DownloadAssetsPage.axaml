<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:items="clr-namespace:Material.Avalonia.Theme.Controls;assembly=Material.Avalonia"
             xmlns:onePointControls="clr-namespace:Material.Avalonia.Theme.Controls;assembly=Material.Avalonia"
             xmlns:notice="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=OnePointUI.Avalonia"
             xmlns:navigation="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation;assembly=OnePointUI.Avalonia"
             xmlns:notice1="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Notice;assembly=Material.Avalonia"
             xmlns:navigation1="clr-namespace:OnePointUI.Avalonia.Styling.Controls.OnePointControls.Navigation;assembly=Material.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="BedrockBoot.Views.Pages.DownloadSubPage.DownloadAssetsPage">
    <Grid RowDefinitions="Auto,*">
        <items:BorderCard Margin="20,15,20,15">
            <Grid>
                <DockPanel LastChildFill="True">
                    <onePointControls:FontIcon Glyph="&#xE721;"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               FontSize="18"
                                               Margin="5,0,10,0"
                                               VerticalAlignment="Center" />

                    <Button DockPanel.Dock="Right"
                            Classes="NoBorder"
                            Margin="5,0"
                            Padding="12,8"
                            Name="SearchBtn"
                            Click="SearchBtn_OnClick">
                        <StackPanel Orientation="Horizontal"
                                    Spacing="8">
                            <onePointControls:FontIcon Glyph="&#xE71E;"
                                                       FontSize="16"
                                                       VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource Shared.Action.Search}" />
                        </StackPanel>
                    </Button>

                    <TextBox Margin="5,0"
                             VerticalAlignment="Center"
                             Height="32"
                             Name="TextBox"
                             HorizontalAlignment="Stretch" />
                </DockPanel>
            </Grid>
        </items:BorderCard>

        <notice1:LoadCard Grid.Row="1" HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         BigTitle="{DynamicResource Download.Assets.Status.Loading.Title}"
                         Message="{DynamicResource Download.Assets.Status.Loading.Message}"
                         Name="LoadingRing" />

        <notice1:InfoCard Grid.Row="1" VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         Glyph="&#xE822;"
                         BigTitle="{DynamicResource Download.Assets.Status.Empty.Title}"
                         Message="{DynamicResource Download.Assets.Status.Empty.Message}"
                         Name="NoneBox" />

        <navigation1:LotsPageFrame Grid.Row="1"
                                  Name="ResultPage" />
    </Grid>
</UserControl>